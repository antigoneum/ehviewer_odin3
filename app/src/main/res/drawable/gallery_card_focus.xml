<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <!-- Keep the stroke inside CardView's rounded outline and shadow padding. -->
        <inset android:insetLeft="6dp" android:insetTop="6dp"
            android:insetRight="6dp" android:insetBottom="6dp">
            <shape android:shape="rectangle">
                <solid android:color="@android:color/transparent" />
                <stroke android:width="3dp" android:color="?attr/colorAccent" />
                <corners android:radius="4dp" />
            </shape>
        </inset>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
